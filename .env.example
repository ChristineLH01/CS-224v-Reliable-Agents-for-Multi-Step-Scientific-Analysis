# Copy to .env (git-ignored). bmbench loads it automatically.

# Claude Code auth inside the Docker sandbox: set ONE of these.
# - Claude subscription (your claude.ai seat): run `claude setup-token` and paste the token.
CLAUDE_CODE_OAUTH_TOKEN=
# - Or an Anthropic API key (pay per token).
ANTHROPIC_API_KEY=

# Hugging Face read token; only needed for the gated BioMysteryBench-full.
HF_TOKEN=

# The LiteLLM proxy (OpenAI-compatible): Codex uses it as its model provider (the key is 
# passed into Codex's sandbox only), and the judge (GPT-6 Sol) calls it from the host.
LITELLM_BASE_URL=https://models.genie.stanford.edu/v1/chat/completions
LITELLM_API_KEY=
